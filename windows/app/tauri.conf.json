{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cleanpasta",
  "version": "1.2.0",
  "identifier": "com.eryksadowski.cleanpasta",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "Cleanpasta 1.2.0",
        "width": 560,
        "height": 740,
        "visible": false,
        "url": "index.html"
      },
      {
        "label": "hud",
        "title": "Cleanpasta",
        "url": "hud.html",
        "width": 420,
        "height": 86,
        "visible": false,
        "focus": false,
        "focusable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' asset:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "Eryk Sadowski",
    "copyright": "Eryk Sadowski",
    "shortDescription": "Paste formatted text without backgrounds, colors and fonts",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cleanpasta"
        ]
      }
    },
    "updater": {
      "pubkey": "REPLACE_WITH_ERYKS_ED25519_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/iameryksadowski/cleanpasta-app/releases/latest/download/windows-latest.json"
      ]
    }
  }
}
